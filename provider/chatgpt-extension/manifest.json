{
  "manifest_version": 3,
  "name": "PCBridge M1 ChatGPT Companion",
  "version": "0.1.0",
  "description": "Dedicated-profile ChatGPT transport for PCBridge M1 autonomous handoff.",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8795/*",
    "http://127.0.0.1:8796/*",
    "http://127.0.0.1:8797/*",
    "http://127.0.0.1:8798/*",
    "http://127.0.0.1:8799/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["chatgpt-dom.js", "content.js"],
    "run_at": "document_idle"
  }]
}
